#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker amazon-cloudwatch-agent

systemctl enable --now docker

mkdir -p /opt/devops-app
mkdir -p /var/log/app

cat >/opt/devops-app/app.env <<EOF
APP_ENV=${environment}
PORT=3000
DB_HOST=${db_host}
DB_PORT=5432
DB_NAME=${db_name}
DB_USER=${db_user}
DB_PASSWORD=${db_password}
LOG_FILE=/var/log/app/app.log
EOF

chmod 600 /opt/devops-app/app.env

cat >/opt/aws/amazon-cloudwatch-agent.json <<'EOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/app/app.log",
            "log_group_name": "/devops-assignment/application",
            "log_stream_name": "{instance_id}/${environment}",
            "retention_in_days": 7
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "DevOpsAssignment",
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "resources": [
          "*"
        ],
        "metrics_collection_interval": 60
      }
    }
  }
}
EOF

systemctl enable amazon-cloudwatch-agent
systemctl restart amazon-cloudwatch-agent

# Deployment workflow will place the Docker image here.
touch /opt/devops-app/READY
